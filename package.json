{
  "name": "switch2-mod-merger",
  "version": "0.1.0",
  "description": "Merge Switch 2 mods that replace the same compressed archives, entirely in your browser. No uploads, no server - your files never leave your machine.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "biome check .",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "0.0.27",
    "jszip": "3.10.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@evilmartians/lefthook": "^2.2.2",
    "playwright-core": "^1.65.0",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.9.1"
}
